generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ORGANIZER
  ADMINISTRATOR
}

enum QuestionType {
  AB
  MULTI
}

enum QuestionLifecycle {
  DRAFT
  PUBLISHED
  RESOLVED
  CANCELLED
  HIDDEN
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  balance      Int      @default(1000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions Transaction[]
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  questions Question[]
}

model Question {
  id             String            @id @default(cuid())
  title          String
  categoryId     String
  type           QuestionType
  lifecycle      QuestionLifecycle @default(PUBLISHED)
  deadline       DateTime
  criteria       String
  source         String
  startingPriceA Int               @default(50)
  probabilityA   Float             @default(0.5)
  totalCredits   Int               @default(0)
  credits24h     Int               @default(0)
  correctAnswerId String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  category Category         @relation(fields: [categoryId], references: [id])
  answers  QuestionAnswer[]

  @@index([categoryId, deadline])
  @@index([lifecycle, deadline])
}

model QuestionAnswer {
  id         String   @id @default(cuid())
  questionId String
  label      String
  sortOrder  Int
  credits    Int      @default(0)
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, sortOrder])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  type      String
  reason    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
