generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ORGANIZER
  ADMINISTRATOR
}

enum QuestionType {
  AB
  MULTI_ANSWER
}

enum QuestionStatus {
  DRAFT
  OPEN
  CLOSED
  RESOLVED
  CANCELLED
}

enum LedgerType {
  STARTING
  WEEKLY
  COUPON
  PREDICTION
  PAYOUT
  REFUND
  CORRECTION
}

enum AdminAuditAction {
  ROLE_CHANGE
  QUESTION_CANCELLATION
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  balance      Int      @default(1000)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizedQuestions Question[]     @relation("QuestionOrganizer")
  predictions        Prediction[]
  ledgerEntries      CreditLedger[]
  responsibleEntries CreditLedger[] @relation("LedgerResponsibleUser")
  adminAudits        AdminAudit[]    @relation("AuditResponsibleUser")
  roleChanges        AdminAudit[]    @relation("AuditTargetUser")
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  questions Question[]
}

model Question {
  id              String         @id @default(cuid())
  title           String
  type            QuestionType
  status          QuestionStatus @default(DRAFT)
  categoryId      String
  organizerId     String
  deadline        DateTime
  eventTime       DateTime
  timeZone        String         @default("America/Los_Angeles")
  outcomeCriteria String
  source          String
  startingPriceA  Int?
  aSharesHundredths Int            @default(0)
  bSharesHundredths Int            @default(0)
  marketVersion     Int            @default(0)
  isHidden        Boolean        @default(false)
  resolutionNote  String?
  correctAnswerId String?        @unique
  publishedAt     DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  category      Category        @relation(fields: [categoryId], references: [id])
  organizer     User            @relation("QuestionOrganizer", fields: [organizerId], references: [id])
  answers       Answer[]        @relation("QuestionAnswers")
  correctAnswer Answer?         @relation("QuestionCorrectAnswer", fields: [correctAnswerId], references: [id])
  predictions   Prediction[]
  snapshots     PriceSnapshot[]
  adminAudits   AdminAudit[]

  @@index([status, deadline])
  @@index([categoryId, status])
  @@index([organizerId, status])
}

model AdminAudit {
  id                String           @id @default(cuid())
  action            AdminAuditAction
  targetUserId      String?
  questionId        String?
  previousRole      Role?
  newRole           Role?
  amount            Int?
  reason            String
  responsibleUserId String
  createdAt         DateTime         @default(now())

  responsibleUser User      @relation("AuditResponsibleUser", fields: [responsibleUserId], references: [id])
  targetUser      User?     @relation("AuditTargetUser", fields: [targetUserId], references: [id])
  question        Question? @relation(fields: [questionId], references: [id])

  @@index([targetUserId, createdAt])
  @@index([questionId, createdAt])
  @@index([responsibleUserId, createdAt])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  text       String
  sortOrder  Int
  isOther    Boolean  @default(false)
  createdAt  DateTime @default(now())

  question       Question         @relation("QuestionAnswers", fields: [questionId], references: [id], onDelete: Cascade)
  correctFor     Question?        @relation("QuestionCorrectAnswer")
  predictions    Prediction[]
  snapshotTotals AnswerSnapshot[]

  @@unique([questionId, text])
  @@unique([questionId, sortOrder])
  @@index([questionId, sortOrder])
}

model Prediction {
  id                  String   @id @default(cuid())
  userId              String
  questionId          String
  answerId            String
  creditsCharged      Int
  shares              Decimal? @db.Decimal(20, 2)
  priceAAtPurchase    Decimal? @db.Decimal(12, 8)
  priceBAtPurchase    Decimal? @db.Decimal(12, 8)
  poolTotalAtPurchase Int?
  idempotencyKey      String?
  createdAt           DateTime   @default(now())

  user     User          @relation(fields: [userId], references: [id])
  question Question      @relation(fields: [questionId], references: [id])
  answer   Answer        @relation(fields: [answerId], references: [id])
  ledger   CreditLedger?

  @@index([questionId, createdAt])
  @@index([userId, createdAt])
  @@index([answerId, createdAt])
  @@unique([userId, idempotencyKey])
}

model CreditLedger {
  id                String     @id @default(cuid())
  userId            String
  type              LedgerType
  amount            Int
  reason            String?
  predictionId      String?    @unique
  responsibleUserId String?
  createdAt         DateTime   @default(now())

  user            User        @relation(fields: [userId], references: [id])
  prediction      Prediction? @relation(fields: [predictionId], references: [id])
  responsibleUser User?       @relation("LedgerResponsibleUser", fields: [responsibleUserId], references: [id])

  @@index([userId, createdAt])
}

model PriceSnapshot {
  id         String   @id @default(cuid())
  questionId String
  recordedAt DateTime @default(now())
  priceA     Decimal? @db.Decimal(12, 8)
  priceB     Decimal? @db.Decimal(12, 8)
  poolTotal  Int      @default(0)

  question Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AnswerSnapshot[]

  @@index([questionId, recordedAt])
}

model AnswerSnapshot {
  snapshotId   String
  answerId     String
  creditsTotal Int

  snapshot PriceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  answer   Answer        @relation(fields: [answerId], references: [id])

  @@id([snapshotId, answerId])
}
